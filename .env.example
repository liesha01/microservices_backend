# --- Application Config ---
APP_PROFILE=docker

# --- Database Credentials --- 
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
DB_HOST=postgres

# --- Infrastructure URLs ---
EUREKA_SERVER_URL=http://discovery-server:8761/eureka/
CONFIG_SERVER_URL=http://config-server:8888/
CONFIG_GIT_URI=https://github.com/YOUR_USERNAME/ecommerce-microservices-config-repo
CONFIG_GIT_BRANCH=master
ZIPKIN_URL=http://zipkin:9411/api/v2/spans

# --- Redis & Kafka ---
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_HOST=kafka
KAFKA_PORT_INTERNAL=9092
KAFKA_PORT_EXTERNAL=29092
ZOOKEEPER_HOST=zookeeper
ZOOKEEPER_PORT=2181

# --- Service Ports ---
PORT_GATEWAY=8080
PORT_DISCOVERY=8761
PORT_CONFIG=8888
PORT_ZIPKIN=9411
PORT_AUTH=8081
PORT_USER=8082
PORT_PRODUCT=8083
PORT_ORDER=8084
PORT_INVENTORY=8085
PORT_PAYMENT=8086
PORT_NOTIFICATION=8087

# --- Security (JWT) ---
# CHANGE THIS TO A STRONG SECRET IN PRODUCTION!
JWT_SECRET_KEY=put_your_strong_secret_key_here
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- Service Configs ---
PAYMENT_SUCCESS_RATE=0.9
PAYMENT_DELAY_MS=1000
EMAIL_ENABLED=true
SMS_ENABLED=true
